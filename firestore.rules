rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The tRPC API uses the Admin SDK, which bypasses these rules.
    // Clients get no direct access. Add rules here if a client must read
    // or write a collection directly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
