# Development needs none of the Firebase values: `pnpm dev` runs the emulators
# as the local-only `demo-sustainable-saratoga` project, and the defaults in
# the code point at it. Leave VITE_FIREBASE_PROJECT_ID unset locally, or API
# calls go to a project the emulators aren't running.
#
# Vite reads env files from packages/frontend, not from this folder. CI sets
# the production values as GitHub secrets and vars (see deploy.yaml); to
# build for production locally, put them in packages/frontend/.env.local,
# copied from Firebase console > Project settings > Your apps > SDK setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Region of the `api` function. Change it in
# packages/backend/src/index.ts and firebase.json at the same time.
VITE_FUNCTIONS_REGION=us-central1

# dm ori to get values, and never share!
# for local dev, put them in packages/frontend/.env.local: vite
# reads env files from the frontend package, not from this folder.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
