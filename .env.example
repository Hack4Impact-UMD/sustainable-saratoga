# Development needs none of these: the emulators accept any value and the
# defaults in the code point at the `demo-vtf-template` project.
#
# For production, copy this file to `.env`, then paste the values from
# Firebase console > Project settings > Your apps > SDK setup and config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Region of the `api` function. Change it in
# packages/backend/src/index.ts and firebase.json at the same time.
VITE_FUNCTIONS_REGION=us-central1
