# Copy this file to `.env.local` in this folder (packages/frontend). Vite only
# reads env files from here, so a `.env` in the repo root does nothing.

VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Production only: CI sets these from GitHub secrets. Leave them commented
# out locally; set even to empty, they break auth against the emulators.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

