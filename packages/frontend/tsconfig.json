{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@common/*": ["../../packages/common/src/*"],
      "@backend/*": ["../../packages/backend/src/*"],
      "@frontend/*": ["./src/*"],
      "@e2e/*": ["../../e2e/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
